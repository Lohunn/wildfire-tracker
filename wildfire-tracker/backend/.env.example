# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# Free key from https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=your_airnow_api_key_here

# NWS API requires a descriptive User-Agent, not a key. Put contact info here.
NWS_USER_AGENT=wildfire-context-tracker (you@example.com)

PORT=4000
